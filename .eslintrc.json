{
  "root": true,
  "env": {
    "browser": true,
    "es6": true,
    "jquery": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2017,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "globals": {
    "$": "readonly",
    "jQuery": "readonly",
    "wp": "readonly"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off"
  }
}
